# The bridge runs with zero configuration — every value below has a sensible
# default baked in. Copy this file to ".env" (next to the executable when
# packaged) only if you need to override something.

# Bloomberg Terminal connection (defaults match a local Bloomberg Terminal).
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194

# Local HTTP/WebSocket server the explorer talks to.
APP_HOST=127.0.0.1
APP_PORT=8000

# Browser origins allowed to call the bridge (comma separated).
# Defaults to the hosted Universe Studio explorer plus localhost dev ports.
CORS_ORIGINS=https://universe.thesimplereport.com,http://localhost:5173,http://localhost:3000
