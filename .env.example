# Bloomberg Terminal connection (defaults match a local Bloomberg Terminal)
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194

# FastAPI server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false

# Optional shared-secret header that the JS client must send.
# Leave blank to disable auth.
API_KEY=

# CORS origins for your Universe Studio JS explorer (comma separated).
# Use "*" to allow any origin during development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Local SQL database ---------------------------------------------------
# SQLAlchemy URL. Examples:
#   sqlite:///./data-bridge.db
#   postgresql+psycopg://user:pass@localhost:5432/universe
#   mysql+pymysql://user:pass@localhost:3306/universe
#   mssql+pyodbc://user:pass@dsn
# Leave empty to disable the /sql endpoints entirely.
DATABASE_URL=sqlite:///./data-bridge.db

# If true, only SELECT / read-only queries are accepted on /sql/query.
# Set to false to allow INSERT/UPDATE/DELETE/DDL (use with care).
SQL_READ_ONLY=true

# Hard cap on rows returned from /sql/query to protect the client.
SQL_MAX_ROWS=10000
